# localmesh-router — TCP active-standby router for the HA pair.
#
# Mirrors the root Dockerfile's build conventions (same toolchain,
# flags, and non-root runtime) but ships only the router binary.
# Used by deploy/ha.compose.yml.

FROM golang:1.27-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/localmesh-router ./cmd/localmesh-router

FROM alpine:3.21
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 localmesh
COPY --from=build /out/localmesh-router /usr/local/bin/localmesh-router
USER localmesh
EXPOSE 8443
ENTRYPOINT ["localmesh-router"]
