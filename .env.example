# LocalMesh compose configuration — copy to .env, or generate a complete
# production file with real secrets:
#
#   ./scripts/gen-secrets.sh            # writes ./.env with mode 0600
#
# This file contains PLACEHOLDERS ONLY. Compose fails loudly
# (${VAR:?…}) when a required value is unset. For the hardened
# deployment see deploy/secure.example.yml + docs/production-hardening.md.
#
# Legend:  [REQUIRED]     must be set for compose to start
#          [PROD]         set explicitly for production deployments
#          [OPTIONAL]     sane default exists
#          [DEV-ONLY]     never set outside local development

# -----------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------

# [REQUIRED] Postgres password for the control-plane database. Postgres
# is never published to the host, but "change-me" in a copy-pasted .env
# is still a real credential — generate a random one (gen-secrets.sh).
POSTGRES_PASSWORD=change-me

# [PROD] Preset admin API key (admin scope — full control). Format
# lmk_<base64url>; minimum 16 chars. When unset the server generates one
# on first boot, prints it once in `docker compose logs server`, and
# writes it to bootstrap-admin.key in the shared data volume.
# NOTE: installed ONLY while no admin key exists — changing this value
# later does NOT rotate the key; rotate from the dashboard/API instead.
# LOCALMESH_ADMIN_KEY=lmk_...

# [PROD] Dashboard sign-in password. When unset the server generates
# bootstrap-dashboard.password in the data volume — retrieve with:
#   docker compose exec web cat /ca/bootstrap-dashboard.password
# LOCALMESH_DASHBOARD_PASSWORD=choose-a-password

# [OPTIONAL] Dashboard session-signing key, consumed by the web service
# (docker-compose.yml, deploy/ha.compose.yml, deploy/secure.example.yml).
# When unset the server generates session.key in the shared data volume
# (stable across restarts). Set it explicitly only if you might wipe
# the volume.
# LOCALMESH_SESSION_KEY=lms_...

# -----------------------------------------------------------------------
# Network identity
# -----------------------------------------------------------------------

# [PROD] Comma-separated DNS names / IPs clients and agents use to reach
# this control plane — each becomes a SAN on the serving certificate.
# Consumed by all shipped compose files: stock + ha default to
# localhost/compose-internal names (override when remote agents or
# clients dial a real name); secure REQUIRES it. The leaf reissues on
# restart when SANs change — fix this and `docker compose restart server`
# if agents fail TLS with "certificate is valid for ..., not <name>".
# LOCALMESH_HOSTNAMES=mesh.example.com,192.168.1.20

# [OPTIONAL] Bind address for the published ports below — read by
# deploy/secure.example.yml (stock compose publishes on all interfaces).
# The hardened example defaults to 127.0.0.1 (localhost-only — reach the
# stack via SSH tunnel or same-host). Set to the host's LAN IP when
# remote agents must enroll; do not publish to untrusted networks.
# LOCALMESH_BIND=127.0.0.1

# [OPTIONAL] Published ports (bound to LOCALMESH_BIND).
LOCALMESH_PORT=8443
LOCALMESH_WEB_PORT=3000

# [OPTIONAL] Cluster name advertised via mDNS + shown in the dashboard.
# LOCALMESH_CLUSTER_NAME=localmesh

# [OPTIONAL] mDNS LAN discovery (_localmesh._tcp). Advertises port,
# cluster name, and CA fingerprint — public info, authorizes nothing.
# Default on in the stock compose; the hardened example defaults off.
# Needs network_mode: host or bare-metal to reach the real LAN.
# LOCALMESH_DISCOVERY=off

# [OPTIONAL] Trust X-Forwarded-For for rate limiting — wired into the
# server service in all shipped compose files. Set to 1 ONLY behind a
# reverse proxy that overwrites the header — otherwise any client can
# spoof its rate-limit identity.
# LOCALMESH_TRUST_PROXY=1

# [OPTIONAL] CORS origins (comma-separated) — wired into the server
# service in all shipped compose files. Unneeded with the stock
# dashboard (same-origin BFF); set only for third-party web clients.
# LOCALMESH_CORS_ORIGINS=

# [OPTIONAL] Server log level: debug | info (default) | warn | error —
# wired into the server service in all shipped compose files.
# LOCALMESH_LOG_LEVEL=info

# -----------------------------------------------------------------------
# HA pair (deploy/ha.compose.yml or the commented block in
# deploy/secure.example.yml) — leave unset on the single-node stack
# -----------------------------------------------------------------------

# [OPTIONAL] Run a manually-launched instance as an active-standby replica
# (LOCALMESH_ROLE=standby also works). The standby shares the data volume
# and serves the primary's CA. deploy/ha.compose.yml sets this itself on
# its server-standby service — no need to set it here.
# LOCALMESH_STANDBY=1

# [OPTIONAL] Router tuning — see docs/ha-deployment.md.
# LOCALMESH_ROUTER_INTERVAL=1s
# LOCALMESH_ROUTER_STATUS_PORT=9443

# -----------------------------------------------------------------------
# DEV-ONLY — never set in production
# -----------------------------------------------------------------------

# [DEV-ONLY] Disables TLS entirely and listens on :8080 HTTP. For local
# `go run` development only — a server started this way serves the whole
# API unauthenticated-in-transit; credentials and prompts cross in clear
# text. It is NOT refused or loudly warned when combined with production
# settings (see docs/security-audit-v09.md) — keep it out of prod envs.
# LOCALMESH_DEV_INSECURE_HTTP=1

# [DEV-ONLY] Dashboard skips TLS verification of the control plane. The
# correct production path is LOCALMESH_CA_FILE (wired in compose).
# LOCALMESH_TLS_INSECURE=1

# [DEV-ONLY] Direct DSN override — only needed when NOT using the
# bundled postgres (e.g. managed Postgres; then use sslmode=require).
# LOCALMESH_DATABASE_URL=postgres://localmesh:...@host:5432/localmesh?sslmode=require
