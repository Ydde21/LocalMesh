# LocalMesh compose configuration — copy to .env

# Postgres password for the control-plane database (required).
POSTGRES_PASSWORD=change-me

# Optional: preset admin API key for the dashboard + admin API.
# If unset, one is generated on first boot and printed once in
# `docker compose logs server`. Must be at least 16 chars.
# LOCALMESH_ADMIN_KEY=lmk_...

# Optional: dashboard sign-in password. If unset, the server generates
# one into the shared data volume — retrieve it with:
#   docker compose exec web cat /ca/bootstrap-dashboard.password
# LOCALMESH_DASHBOARD_PASSWORD=choose-a-password

# Ports exposed on the host.
LOCALMESH_PORT=8443
LOCALMESH_WEB_PORT=3000
